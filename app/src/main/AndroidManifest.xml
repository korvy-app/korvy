<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet is used only by Online features (off by default; one switch per source, all through
         platform/Net.kt). Android grants this permission at install; the app's own switches decide use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the assistant start a countdown in the Clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Voice input: asked for only when the user first taps the mic; on-device recognition only. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- See every launchable app (a launcher's core job). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- allowBackup=false: hidden apps, usage patterns and settings never leave the phone. -->
    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode|screenSize|smallestScreenSize|screenLayout|orientation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also in the app list, so it can be opened before it's the default home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Holding the power button (when this app is the digital assistant) opens this panel over any app. -->
        <activity
            android:name=".AssistActivity"
            android:exported="true"
            android:theme="@style/Theme.Launcher.Panel"
            android:taskAffinity="com.hiddenoutlier.launcher.assist"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The on-device model runs in its own process so the launcher stays light. -->
        <service
            android:name=".assistant.AssistantService"
            android:exported="false"
            android:process=":assistant" />
    </application>
</manifest>
